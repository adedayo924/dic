# Normalize line endings
* text=auto eol=crlf

# Source files
*.cs        text diff=csharp
*.xaml      text
*.csproj    text
*.sln       text eol=crlf
*.props     text
*.targets   text
*.json      text
*.config    text
*.xml       text
*.md        text
*.yml       text eol=lf
*.yaml      text eol=lf

# Binary
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.dll       binary
*.pdb       binary
*.snk       binary
*.pfx       binary
*.p12       binary
