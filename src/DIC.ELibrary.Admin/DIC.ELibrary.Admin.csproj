<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DIC.ELibrary.UI\DIC.ELibrary.UI.csproj" />
    <ProjectReference Include="..\DIC.ELibrary.Core\DIC.ELibrary.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>DIC.ELibrary.Admin</AssemblyName>
    <RootNamespace>DIC.ELibrary.Admin</RootNamespace>
    <ApplicationIcon>..\..\assets\dic_logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
