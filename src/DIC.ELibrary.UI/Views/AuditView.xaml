<UserControl x:Class="DIC.ELibrary.UI.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AuditViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Audit log" Style="{StaticResource H1Text}" />
            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Content="Refresh"
                    Command="{Binding RefreshCommand}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,12,0,0">
        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Results}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat=dd MMM yyyy HH:mm}" Width="160" />
                <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="150" />
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="160" />
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" />
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" MinWidth="200" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No audit entries." Style="{StaticResource EmptyState}"
                   Visibility="{Binding Results, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="← Previous" Command="{Binding PreviousCommand}" />
            <TextBlock Margin="16,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                <Run Text="Page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text="   (" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" entries)" />
            </TextBlock>
            <Button Style="{StaticResource GhostButton}" Content="Next →" Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
