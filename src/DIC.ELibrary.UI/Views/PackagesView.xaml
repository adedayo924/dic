<UserControl x:Class="DIC.ELibrary.UI.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PackagesViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="24" MaxWidth="820" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Packages" Style="{StaticResource H1Text}" />
            <TextBlock Margin="0,2,0,16" Text="Build signed .dicpkg packages, install them, and export the catalog."
                       Style="{StaticResource CaptionText}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Build a package" Style="{StaticResource H2Text}" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" Style="{StaticResource InputComboBox}"
                              ItemsSource="{Binding Books}" SelectedItem="{Binding SelectedBook}"
                              DisplayMemberPath="Title" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                            Content="Build .dicpkg…" Command="{Binding BuildCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Inspect &amp; distribute" Style="{StaticResource H2Text}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="Inspect package…"
                            Command="{Binding InspectCommand}" />
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="Install package…"
                            Command="{Binding InstallCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Export catalog (.dicl)…"
                            Command="{Binding ExportCatalogCommand}" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Text="{Binding InspectionSummary}" Style="{StaticResource BodyText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
