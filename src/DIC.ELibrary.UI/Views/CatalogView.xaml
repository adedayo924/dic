<UserControl x:Class="DIC.ELibrary.UI.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Catalog" Style="{StaticResource H1Text}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12">
            <WrapPanel>
                <TextBox Width="300" MinWidth="200" VerticalAlignment="Center" Margin="0,0,10,0"
                         Style="{StaticResource InputTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by title, author or ISBN" />

                <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="Full text"
                          IsChecked="{Binding FullText}" />

                <ComboBox Width="170" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource InputComboBox}"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" />

                <ComboBox Width="160" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource InputComboBox}"
                          ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort}"
                          DisplayMemberPath="Label" />

                <Button VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource PrimaryButton}"
                        Content="Search" Command="{Binding SearchCommand}" />
                <Button VerticalAlignment="Center" Style="{StaticResource GhostButton}"
                        Content="Clear" Command="{Binding ClearCommand}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
        <ListBox BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                 Background="{DynamicResource InputBackgroundBrush}" ItemsSource="{Binding Results}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="54" CornerRadius="4"
                                Background="{StaticResource BackgroundBrush}" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="📘" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextDisabledBrush}" />
                                <Image Stretch="UniformToFill" Source="{Binding CoverPath, Converter={StaticResource PathToImage}}" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" Style="{StaticResource BodyText}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Author, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding CategoryName, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding PublicationYear, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryButton}"
                                Content="View"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="No books found. Try a different search." Style="{StaticResource EmptyState}"
                   Visibility="{Binding Results, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="← Previous" Command="{Binding PreviousCommand}" />
            <TextBlock Margin="16,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                <Run Text="Page " />
                <Run Text="{Binding Page, Mode=OneWay}" />
                <Run Text=" of " />
                <Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text="   (" />
                <Run Text="{Binding TotalCount, Mode=OneWay}" />
                <Run Text=" books)" />
            </TextBlock>
            <Button Style="{StaticResource GhostButton}" Content="Next →" Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
