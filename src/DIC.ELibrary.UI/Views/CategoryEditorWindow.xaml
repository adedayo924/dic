<Window x:Class="DIC.ELibrary.UI.Views.CategoryEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CategoryEditorViewModel}"
        Title="Book category"
        Height="400" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Header}" Style="{StaticResource H2Text}" Margin="0,0,0,12" />

                <TextBlock Text="Name *" Style="{StaticResource CaptionText}" />
                <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,10"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Description" Style="{StaticResource CaptionText}" />
                <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,0" Height="120"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
