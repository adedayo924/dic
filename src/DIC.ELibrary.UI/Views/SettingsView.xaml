<UserControl x:Class="DIC.ELibrary.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1Text}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Account" Style="{StaticResource H2Text}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}">
                        <Run Text="Signed in as " /><Run Text="{Binding AccountName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" (" /><Run Text="{Binding AccountRole, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Change password" Style="{StaticResource H2Text}" />
                    <TextBlock Margin="0,4,0,12" Text="Use a strong password of at least 6 characters."
                               Style="{StaticResource CaptionText}" />

                    <TextBlock Text="Current password" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                    <PasswordBox x:Name="CurrentBox" Style="{StaticResource InputPasswordBox}"
                                 PasswordChanged="OnPasswordChanged" Tag="current" />

                    <TextBlock Text="New password" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="NewBox" Style="{StaticResource InputPasswordBox}"
                                 PasswordChanged="OnPasswordChanged" Tag="new" />

                    <TextBlock Text="Confirm new password" Style="{StaticResource CaptionText}" Margin="0,12,0,4" />
                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource InputPasswordBox}"
                                 PasswordChanged="OnPasswordChanged" Tag="confirm" />

                    <TextBlock Margin="0,12,0,0" Text="{Binding PasswordMessage}" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource IndigoBrush}" />

                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"
                            Content="Update password" Command="{Binding ChangePasswordCommand}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H2Text}" />
                    <TextBlock Margin="0,4,0,12" Text="Choose the interface theme."
                                Style="{StaticResource CaptionText}" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ComboBox Margin="12,0,0,0" Width="140" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource AppLogo}" Height="40" Stretch="Uniform"
                               VerticalAlignment="Center" />
                        <TextBlock Text="About" Style="{StaticResource H2Text}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyText}">
                        <Run Text="Version " /><Run Text="{Binding AppVersion, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                                Visibility="{Binding ShowLibraryData, Converter={StaticResource BoolToVisibility}}"
                                Text="{Binding DataDirectory, StringFormat=Library data: {0}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
