<UserControl x:Class="DIC.ELibrary.UI.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:UsersViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Users" Style="{StaticResource H1Text}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="Import CSV"
                        Command="{Binding ImportCsvCommand}"
                        Visibility="{Binding CanManageBulk, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="CSV template"
                        Command="{Binding DownloadTemplateCommand}"
                        Visibility="{Binding CanManageBulk, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource PrimaryButton}" Content="+ New user"
                        Command="{Binding NewCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" MinWidth="200" Style="{StaticResource InputTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Search"
                        Command="{Binding SearchCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Results}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150" MinWidth="110" />
                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180" MinWidth="130" />
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120" />
                <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                <DataGridTextColumn Header="Loans" Binding="{Binding ActiveLoans}" Width="70" />
                <DataGridTemplateColumn Header="" Width="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Content="Edit"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Content="Activate"
                                        Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource DangerButton}" Content="Delete"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No users match your search." Style="{StaticResource EmptyState}"
                   Visibility="{Binding Results, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="← Previous" Command="{Binding PreviousCommand}" />
            <TextBlock Margin="16,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                <Run Text="Page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text="   (" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" users)" />
            </TextBlock>
            <Button Style="{StaticResource GhostButton}" Content="Next →" Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
