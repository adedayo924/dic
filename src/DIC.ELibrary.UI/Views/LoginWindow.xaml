<Window x:Class="DIC.ELibrary.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sign in"
        Height="560" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource IndigoBrush}" Padding="28,26">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="8" Background="White" Padding="3">
                        <Image Source="{StaticResource AppLogo}" Stretch="Uniform" />
                    </Border>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="20" FontWeight="SemiBold" Foreground="White"
                               Text="{Binding Shell.ProductName}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#D7DBF5"
                           Text="{Binding Shell.Subtitle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="28" Style="{StaticResource Card}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel VerticalAlignment="Center">
                <Image Source="{StaticResource AppLogo}" Height="72" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="Sign in to continue" Style="{StaticResource H2Text}" />
                <TextBlock Margin="0,4,0,18" Text="{Binding RoleSubtitle}"
                           Style="{StaticResource CaptionText}" />

                <TextBlock Text="Username" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource InputTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Password" Style="{StaticResource CaptionText}" Margin="0,14,0,4" />
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}"
                             PasswordChanged="OnPasswordChanged" />

                <TextBlock Margin="0,14,0,0" Foreground="{StaticResource RedBrush}"
                           Text="{Binding ErrorMessage}"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}"
                           TextWrapping="Wrap" />

                <Button Margin="0,18,0,0" Style="{StaticResource PrimaryButton}"
                        Content="Sign in" IsDefault="True" Click="OnSignIn" />

                <Button Margin="0,10,0,0" Style="{StaticResource GhostButton}"
                        Content="← Choose a different role" IsCancel="True" />

                <TextBlock x:Name="BusyText" Margin="0,12,0,0" HorizontalAlignment="Center"
                           Text="Signing in…" Style="{StaticResource CaptionText}"
                           Visibility="Collapsed" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
