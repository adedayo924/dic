<UserControl x:Class="DIC.ELibrary.UI.Views.BooksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BooksViewModel}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="Books" Style="{StaticResource H1Text}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="Import CSV"
                        Command="{Binding ImportCsvCommand}" />
                <Button Style="{StaticResource PrimaryButton}" Content="+ New book"
                        Command="{Binding NewCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,12">
            <WrapPanel>
                <TextBox Width="300" MinWidth="200" VerticalAlignment="Center" Margin="0,0,10,0"
                         Style="{StaticResource InputTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="170" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource InputComboBox}"
                          ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" />
                <ComboBox Width="150" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource InputComboBox}"
                          ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatus}"
                          DisplayMemberPath="Label" />
                <Button VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" Content="Search"
                        Command="{Binding SearchCommand}" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
        <DataGrid Style="{StaticResource DataGridStyle}" ItemsSource="{Binding Results}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="150" MinWidth="110" />
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="130" MinWidth="90" />
                <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="70" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                <DataGridTextColumn Header="OCR" Binding="{Binding OcrStatus}" Width="90" />
                <DataGridTemplateColumn Header="" Width="200">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Content="Edit"
                                        Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Content="Publish/Archive"
                                        Command="{Binding DataContext.SetStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource DangerButton}" Content="Delete"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Text="No books match your search." Style="{StaticResource EmptyState}"
                   Visibility="{Binding Results, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button Style="{StaticResource GhostButton}" Content="← Previous" Command="{Binding PreviousCommand}" />
            <TextBlock Margin="16,0" VerticalAlignment="Center" Style="{StaticResource BodyText}">
                <Run Text="Page " /><Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding TotalPages, Mode=OneWay}" />
                <Run Text="   (" /><Run Text="{Binding TotalCount, Mode=OneWay}" /><Run Text=" books)" />
            </TextBlock>
            <Button Style="{StaticResource GhostButton}" Content="Next →" Command="{Binding NextCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
