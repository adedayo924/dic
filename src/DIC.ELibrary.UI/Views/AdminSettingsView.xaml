<UserControl x:Class="DIC.ELibrary.UI.Views.AdminSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminSettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Admin settings" Style="{StaticResource H1Text}" Margin="0,0,0,16" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Library" Style="{StaticResource H2Text}" Margin="0,0,0,10" />
                    <TextBlock Text="Library name" Style="{StaticResource CaptionText}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}"
                                 Text="{Binding LibraryName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                                Content="Save" Command="{Binding SaveSettingsCommand}" />
                    </Grid>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource CaptionText}">
                        <Run Text="Data directory: " /><Run Text="{Binding DataDirectory, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionText}">
                        <Run Text="Database: " /><Run Text="{Binding DatabasePath, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource H2Text}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Theme" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <ComboBox Margin="12,0,0,0" Width="140" Style="{StaticResource InputComboBox}"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Package signing keys" Style="{StaticResource H2Text}" Margin="0,0,0,10" />
                    <TextBlock Style="{StaticResource CaptionText}">
                        <Run Text="Private key present: " /><Run Text="{Binding HasSigningKey, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                        <Run Text="Public key fingerprint: " /><Run Text="{Binding PublicKeyFingerprint, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}" TextWrapping="Wrap">
                        <Run Text="Content key fingerprint: " /><Run Text="{Binding ContentKeyFingerprint, Mode=OneWay}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="Export public key"
                                Command="{Binding ExportPublicKeyCommand}" />
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="Import public key"
                                Command="{Binding ImportPublicKeyCommand}" />
                        <Button Style="{StaticResource DangerButton}" Content="Regenerate signing key"
                                Command="{Binding RegenerateKeyCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Backup &amp; restore" Style="{StaticResource H2Text}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Content="Backup database…"
                                Command="{Binding BackupCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Restore database…"
                                Command="{Binding RestoreCommand}" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" Text="{Binding StatusMessage}" Style="{StaticResource BodyText}"
                               TextWrapping="Wrap" Foreground="{StaticResource IndigoBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
