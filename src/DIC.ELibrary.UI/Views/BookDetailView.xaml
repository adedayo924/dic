<UserControl x:Class="DIC.ELibrary.UI.Views.BookDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BookDetailViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <Button HorizontalAlignment="Left" Margin="0,0,0,12" Style="{StaticResource GhostButton}"
                    Content="← Back" Command="{Binding BackCommand}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Top">
                    <Border Height="300" CornerRadius="4" Background="{StaticResource BackgroundBrush}">
                        <Grid>
                            <TextBlock Text="📘" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextDisabledBrush}" />
                            <Image Stretch="UniformToFill" Source="{Binding Book.CoverPath, Converter={StaticResource PathToImage}}" />
                        </Grid>
                    </Border>
                </Border>

                <StackPanel Grid.Column="1" Margin="24,0,0,0">
                    <TextBlock Text="{Binding Book.Title}" Style="{StaticResource H1Text}" />
                    <TextBlock Margin="0,4,0,0" Text="{Binding Book.Subtitle}" Style="{StaticResource BodyText}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding Book.Subtitle, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Margin="0,10,0,0" FontSize="14" Text="{Binding Book.Author}" Style="{StaticResource BodyText}" />

                    <WrapPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,16,0">
                            <Run Text="Category:" FontWeight="SemiBold" /> <Run Text="{Binding Book.CategoryName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,16,0">
                            <Run Text="Year:" FontWeight="SemiBold" /> <Run Text="{Binding Book.PublicationYear, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,16,0">
                            <Run Text="Pages:" FontWeight="SemiBold" /> <Run Text="{Binding Book.PageCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,16,0">
                            <Run Text="Size:" FontWeight="SemiBold" />
                            <Run Text="{Binding Book.FileSizeBytes, Converter={StaticResource ByteSize}, Mode=OneWay}" />
                        </TextBlock>
                    </WrapPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Content="📖 Read"
                                Command="{Binding ReadCommand}" />
                        <Button Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Content="Borrow"
                                Command="{Binding BorrowCommand}" />
                        <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Content="♡ Favorite"
                                Command="{Binding ToggleFavoriteCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Export .dicpkg"
                                Command="{Binding ExportPackageCommand}" />
                    </StackPanel>

                    <TextBlock Margin="0,24,0,6" Text="Description" Style="{StaticResource H2Text}" />
                    <TextBlock Text="{Binding Book.Description}" Style="{StaticResource BodyText}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
