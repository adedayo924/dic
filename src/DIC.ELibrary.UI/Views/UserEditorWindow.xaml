<Window x:Class="DIC.ELibrary.UI.Views.UserEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:UserEditorViewModel}"
        Title="User account"
        Height="520" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Account details" Style="{StaticResource H2Text}" Margin="0,0,0,12" />

            <TextBlock Text="Username *" Style="{StaticResource CaptionText}" />
            <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,10"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Display name *" Style="{StaticResource CaptionText}" />
            <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,10"
                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Email" Style="{StaticResource CaptionText}" />
            <TextBox Style="{StaticResource InputTextBox}" Margin="0,4,0,10"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Role" Style="{StaticResource CaptionText}" />
                    <ComboBox x:Name="RoleBox" Style="{StaticResource InputComboBox}" Margin="0,4,0,0"
                              SelectedItem="{Binding Role}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <CheckBox Content="Active" IsChecked="{Binding IsActive}" Margin="0,6,0,6" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Password" Style="{StaticResource CaptionText}" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" Margin="0,4,0,0"
                         PasswordChanged="OnPasswordChanged" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionText}"
                       Text="Leave blank to keep the current password. Required for new users (min 6 chars)." />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{StaticResource GhostButton}" Margin="0,0,10,0" Content="Cancel" IsCancel="True" />
            <Button Style="{StaticResource PrimaryButton}" Content="Save" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </Grid>
</Window>
