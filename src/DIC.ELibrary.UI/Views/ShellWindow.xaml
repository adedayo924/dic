<Window x:Class="DIC.ELibrary.UI.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DIC.ELibrary.UI.Converters"
        xmlns:vm="clr-namespace:DIC.ELibrary.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="{Binding Shell.ProductName}"
        Height="760" Width="1180"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:ResourceKeyToBrushConverter x:Key="KeyToBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14"
                Background="{Binding Shell.HeaderBrushKey, Converter={StaticResource KeyToBrush}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                        Background="White" Padding="3">
                    <Image Source="{StaticResource AppLogo}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="White"
                               Text="{Binding Shell.ProductName}" />
                    <TextBlock FontSize="11" Foreground="#D7DBF5" Text="{Binding Shell.Subtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,14,0" VerticalAlignment="Center" Foreground="#E8EAF6"
                               FontSize="12" Text="{Binding UserDisplay}" />
                    <Button Style="{StaticResource GhostButton}" Padding="10,6"
                            Command="{Binding SignOutCommand}" Content="Sign out"
                            Foreground="White" BorderBrush="#55FFFFFF" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" Margin="12" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding GoBackCommand}"
                            IsEnabled="{Binding CanGoBack}"
                            Content="← Back" />
                    <ListBox Style="{StaticResource NavList}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="22" VerticalAlignment="Center" Text="{Binding Glyph}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ContentControl Content="{Binding Current}" />

                <Border Background="#66000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Style="{StaticResource Card}" Padding="28,22">
                        <StackPanel>
                            <ProgressBar IsIndeterminate="True" Width="220" Height="6"
                                         Foreground="{StaticResource IndigoBrush}"
                                         Background="{DynamicResource BorderBrush}" />
                            <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="14" Text="Working…" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
