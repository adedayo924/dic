<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- DIC E-Library brand palette: Indigo + Red. These accents do not change between themes. -->
    <Color x:Key="IndigoColor">#3949AB</Color>
    <Color x:Key="IndigoDarkColor">#283593</Color>
    <Color x:Key="IndigoLightColor">#5C6BC0</Color>
    <Color x:Key="RedColor">#E53935</Color>
    <Color x:Key="RedDarkColor">#B71C1C</Color>
    <Color x:Key="RedLightColor">#EF5350</Color>
    <Color x:Key="AccentColor">#FFB300</Color>
    <Color x:Key="SuccessColor">#2E7D32</Color>
    <Color x:Key="WarningColor">#F9A825</Color>

    <SolidColorBrush x:Key="IndigoBrush" Color="{StaticResource IndigoColor}" />
    <SolidColorBrush x:Key="IndigoDarkBrush" Color="{StaticResource IndigoDarkColor}" />
    <SolidColorBrush x:Key="IndigoLightBrush" Color="{StaticResource IndigoLightColor}" />
    <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="RedDarkBrush" Color="{StaticResource RedDarkColor}" />
    <SolidColorBrush x:Key="RedLightBrush" Color="{StaticResource RedLightColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="White" />

    <!-- Application logo (embedded from assets/dic_logo.png). -->
    <BitmapImage x:Key="AppLogo" UriSource="pack://application:,,,/DIC.ELibrary.UI;component/Assets/dic_logo.png" />

</ResourceDictionary>
